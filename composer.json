{
    "name": "rad-themes/client-portal",
    "description": "Private client portals for Statamic: phases, modules, files and content pages for each client.",
    "type": "statamic-addon",
    "license": "MIT",
    "keywords": [
        "statamic",
        "client portal",
        "addon"
    ],
    "homepage": "https://github.com/rad-themes/client-portal",
    "support": {
        "issues": "https://github.com/rad-themes/client-portal/issues",
        "source": "https://github.com/rad-themes/client-portal"
    },
    "autoload": {
        "psr-4": {
            "RadThemes\\ClientPortal\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RadThemes\\ClientPortal\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Client Portal",
            "description": "Private, branded client portals built with Statamic."
        },
        "laravel": {
            "providers": [
                "RadThemes\\ClientPortal\\ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
